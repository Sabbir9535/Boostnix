generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

model Service {
  id          String        @id @default(uuid())
  name        String
  category    String
  description String
  quantity    Int
  price       Decimal       @db.Decimal(10, 2)
  pricePerUnit Decimal?      @db.Decimal(12, 6)
  status      ServiceStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders Order[]

  @@index([category])
  @@index([status])
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  customerName  String
  phone         String
  email         String?
  serviceId     String
  serviceName   String
  quantity      Int
  socialLink    String
  paymentMethod String
  transactionId String
  amount        Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  customerNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  service Service @relation(fields: [serviceId], references: [id])

  @@index([orderNumber])
  @@index([status])
}
